# Build artifacts
# /target/ is the host workspace at the repo root; firmware/*/target is the
# firmware, which builds on its own with its own target dir.
/target/
firmware/*/target/
tools/*/target/
crates/*/target/

# Rust
# Cargo.lock IS committed: icesickle is a binary, and pinning the exact
# dependency set is part of the security posture (see SECURITY.md).
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# ESP flash artifacts
*.bin
*.elf
*.map
