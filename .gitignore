# Build artifacts
# /target/ is the host workspace at the repo root; the rest are the crates that
# build on their own, each with its own target dir.
/target/
firmware/*/target/
firmware/*/build/
tools/*/target/
crates/*/target/

# ESP-IDF (firmware/esp-idf)
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old

# Rust
# Cargo.lock IS committed: icesickle is a binary, and pinning the exact
# dependency set is part of the security posture (see SECURITY.md).
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# ESP flash artifacts
*.bin
*.elf
*.map
